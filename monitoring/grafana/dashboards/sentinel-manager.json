{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "8.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_manager_request_process_time_count[5m])) * 60",
          "legendFormat": "Requests/min"
        }
      ],
      "title": "RPC Requests / min",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_manager_event_publish_total[5m])) * 60",
          "legendFormat": "Events/min"
        }
      ],
      "title": "Events Published / min",
      "type": "stat"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_manager_container_state_change_total[5m])) * 60",
          "legendFormat": "Container Changes/min"
        }
      ],
      "title": "Container State Changes / min",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Container State Changes",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (state) (rate(sentinel_manager_container_state_change_total[5m])) * 60",
          "legendFormat": "{{state}}"
        }
      ],
      "title": "Container State Changes by State",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (service) (rate(sentinel_manager_container_state_change_total[5m])) * 60",
          "legendFormat": "{{service}}"
        }
      ],
      "title": "Container State Changes by Service",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (container_name) (rate(sentinel_manager_container_state_change_total[5m])) * 60",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "Container State Changes by Container",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 104,
      "title": "Recovery Health (leading indicators)",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Each increment is one container death that will NOT trigger call recovery: call-manager's empty-id guard drops the event. Expected to sit flat at zero. A non-zero rate means the asterisk-id could not be resolved before the container died - check the Redis DB index and that the container's asterisk-proxy sidecar is writing asterisk.<id>.address-internal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (container_name) (rate(sentinel_manager_container_unresolved_asterisk_id_total[5m])) * 60",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "Deaths Published Without a Resolved asterisk-id",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "LEADING INDICATOR - alert on this BEFORE a recovery is lost. A refresh pass found no fresh Redis address for a container whose id was already resolved. The id is deliberately kept (sticky last-known), so nothing has broken yet, but the NEXT recreation of this container will have to re-resolve from nothing. Usually means that container's asterisk-proxy sidecar stopped refreshing its key.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (container_name) (rate(sentinel_manager_container_asterisk_id_refresh_miss_total[5m])) * 60",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "asterisk-id Refresh Misses",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "A refresh pass resolved a DIFFERENT asterisk-id for a container that already had one, and kept the existing id. The fixed-MAC-per-generation invariant says this cannot happen, so any increment is an anomaly. The realistic cause is a MISSED die+start pair (an event stream gap, with the replacement container reusing the same static IP) - in which case the id being kept is the DEAD generation's, and the next death for this container will publish a wrong asterisk-id. Correlate with the reconnect panel below.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "id": 13,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (container_name) (rate(sentinel_manager_container_asterisk_id_conflict_total[5m])) * 60",
          "legendFormat": "{{container_name}}"
        }
      ],
      "title": "asterisk-id Conflicts (kept the existing id)",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "One increment per event-stream attempt that ended. result=\"delivered\" carried events; result=\"idle\" carried none but stayed open past the healthy-lifetime threshold (30s), which is what a proxy restart looks like on an idle fleet - both are normal and both reset the give-up budget. result=\"empty\" is the alertable one: the attempt ended IMMEDIATELY without any event, the signature of an unreachable socket proxy, i.e. sentinel is up but watching nothing. 20 consecutive empty results exit the process (visible Komodo crash-loop); a sustained empty rate BELOW that threshold is a flapping stream that stays up and silently loses events in the gaps - correlate with the conflict panel, since a lost die+start pair is what strands a stale asterisk-id.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "id": 12,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (result) (rate(sentinel_manager_container_event_stream_reconnect_total[5m])) * 60",
          "legendFormat": "{{result}}"
        }
      ],
      "title": "Docker Event Stream Reconnects",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 102,
      "title": "API & RPC Performance",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sentinel_manager_request_process_time_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.90, sum by (le) (rate(sentinel_manager_request_process_time_bucket[5m])))",
          "legendFormat": "p90"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sentinel_manager_request_process_time_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "title": "RPC Request Processing Time Percentiles",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum(rate(sentinel_manager_request_process_time_count[5m])) * 60",
          "legendFormat": "Requests/min"
        }
      ],
      "title": "RPC Request Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 50 },
      "id": 103,
      "title": "Events",
      "type": "row"
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "spanNulls": false,
            "stacking": { "mode": "none" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 51 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "sum by (type) (rate(sentinel_manager_event_publish_total[5m])) * 60",
          "legendFormat": "{{type}}"
        }
      ],
      "title": "Event Publish Rate by Type",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 30,
  "style": "dark",
  "tags": ["sentinel-manager", "voipbin"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sentinel Manager",
  "uid": "sentinel-manager",
  "version": 1
