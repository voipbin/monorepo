
# Go build artifacts
vendor/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test

# Compiled control/manager CLI binaries accidentally left in a service root
# (built from bin-*/cmd/<name>/main.go; the binary name equals <name>).
# These are build outputs, never source. Only match files directly under a
# service root so source dirs like bin-dbscheme-manager/bin-manager/ are safe.
/bin-*/*-control
/bin-*/*-manager
# ...but keep any legitimately tracked source dir that ends in -manager.
!/bin-*/*-manager/

# Go coverage files
*.out

# IDE / Editor settings
.vscode/
.idea/

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python packaging
*.egg-info/
*.egg
dist/
build/

# Logs / temp files
*.log
*.tmp
*.bak
*.swp
.DS_Store

# pytest / coverage
.cache/
.coverage
.pytest_cache/
htmlcov/

# Git worktrees
.worktrees/

# Environment files
.env

# Docs generator output
docs/.docs-gen/

