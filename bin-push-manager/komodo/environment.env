# Komodo Stack-level environment, distinct from docker-compose.yml's own
# service-level `environment:` block. This file is passed as
# komodo-api-deploy.sh's optional 3rd argument and PATCHed into the Stack's
# own `environment` config field, which Komodo writes into this Stack's
# run-directory .env file before `docker compose up` runs.
# docker-compose.yml's `secrets.fcm_sa_json.environment: "FCM_SA_JSON"`
# reads this value at that point to materialize the credential file.
#
# [[BIN_MANAGER__FCM_SERVICE_ACCOUNT_JSON]] is interpolated by Komodo the
# same way as any [[VAR]] reference inside file_contents.
FCM_SA_JSON=[[BIN_MANAGER__FCM_SERVICE_ACCOUNT_JSON]]
